{
  "name": "agent-learning-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:cloud": "DEPLOYMENT_MODE=cloud next dev",
    "dev:local": "DEPLOYMENT_MODE=local LOCAL_BIND_HOST=127.0.0.1 next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "node tests/e2e/home-page-http-smoke.mjs && node tests/e2e/public-pages-http-smoke.mjs && node tests/e2e/health-http-smoke.mjs",
    "test:e2e:local": "EXPECTED_RUNTIME_MODE=local npm run test:e2e && node tests/e2e/learning-state-http.mjs",
    "test:e2e:cloud": "EXPECTED_RUNTIME_MODE=cloud npm run test:e2e && tsx tests/e2e/cloud-auth-state-http.mts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --test tests/baseline-report.test.mjs tests/content-boundaries.test.mjs tests/legacy-content-converter.test.mjs tests/content-audit-cli.test.mjs tests/runtime-source-tracking.test.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:tools && npm run test:unit",
    "test:cloud": "DEPLOYMENT_MODE=cloud npm run test",
    "test:local": "DEPLOYMENT_MODE=local npm run test",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:materials": "tsx scripts/materials.ts drift",
    "materials": "tsx scripts/materials.ts",
    "db:backup": "tsx scripts/database.ts backup",
    "db:restore": "tsx scripts/database.ts restore",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run audit:content && npm run test && npm run build",
    "check:cloud": "DEPLOYMENT_MODE=cloud npm run check",
    "check:local": "DEPLOYMENT_MODE=local npm run check",
    "audit:baseline": "node scripts/baseline-report.mjs --root .. --output-dir reports/baseline",
    "audit:boundaries": "node scripts/audit-content-boundaries.mjs --root .. --output-dir reports/content-boundaries",
    "convert:legacy": "node scripts/convert-legacy-content.mjs --root .. --content-dir content --report-dir reports/legacy-conversion --baseline reports/baseline/baseline.json",
    "audit:ui": "node scripts/ui-review.mjs --output-dir reports/ui-review",
    "audit:functional": "node scripts/functional-regression.mjs --output-dir reports/functional-regression"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
