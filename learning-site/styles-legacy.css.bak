:root {
  color-scheme: light;
  --ink: #182026;
  --muted: #5d6975;
  --subtle: #edf1f4;
  --line: #d9e0e6;
  --paper: #ffffff;
  --wash: #f6f8f5;
  --accent: #177c72;
  --accent-strong: #0f5f58;
  --amber: #c47c1f;
  --red: #b24a3b;
  --shadow: 0 18px 50px rgba(23, 37, 42, 0.1);
  --done: #2e8b57;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    "PingFang SC", "Microsoft YaHei", sans-serif;
  background: var(--wash);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 14px clamp(18px, 4vw, 56px);
  border-bottom: 1px solid rgba(24, 32, 38, 0.08);
  background: rgba(246, 248, 245, 0.92);
  backdrop-filter: blur(18px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: 230px;
}

.brand-mark {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  color: #fff;
  font-weight: 800;
  background: var(--accent);
  border-radius: 8px;
}

.brand strong,
.brand small {
  display: block;
}

.brand small {
  color: var(--muted);
  font-size: 12px;
}

.topnav {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}

.topnav a,
.button,
.reader-link,
.pill-link {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--paper);
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    transform 0.18s ease;
}

.topnav a {
  padding: 8px 12px;
  color: var(--muted);
  font-size: 14px;
}

.topnav a:hover,
.button:hover,
.reader-link:hover,
.pill-link:hover {
  border-color: rgba(23, 124, 114, 0.45);
  transform: translateY(-1px);
}

main {
  overflow: hidden;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: clamp(24px, 5vw, 64px);
  align-items: end;
  min-height: calc(100vh - 68px);
  padding: clamp(56px, 8vw, 110px) clamp(18px, 4vw, 56px) 48px;
  background:
    linear-gradient(120deg, rgba(23, 124, 114, 0.12), transparent 42%),
    linear-gradient(0deg, rgba(196, 124, 31, 0.1), transparent 36%),
    var(--wash);
}

.hero-copy {
  max-width: 860px;
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--accent-strong);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3 {
  margin: 0;
  line-height: 1.12;
}

h1 {
  max-width: 780px;
  font-size: clamp(42px, 7vw, 82px);
}

h2 {
  font-size: clamp(28px, 4vw, 46px);
}

h3 {
  font-size: 21px;
}

.hero-copy p:not(.eyebrow),
.section-heading p {
  max-width: 780px;
  color: var(--muted);
  font-size: 18px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 10px 16px;
  color: var(--ink);
  font-weight: 700;
}

.button.primary {
  color: #fff;
  border-color: var(--accent);
  background: var(--accent);
}

.hero-panel {
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: var(--shadow);
}

.hero-panel h2 {
  margin-bottom: 16px;
  font-size: 24px;
}

.hero-panel ol {
  display: grid;
  gap: 12px;
  margin: 0;
  padding-left: 22px;
}

.toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: end;
  padding: 22px clamp(18px, 4vw, 56px);
  border-block: 1px solid rgba(24, 32, 38, 0.08);
  background: var(--paper);
}

.search-wrap label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

input[type="search"] {
  width: 100%;
  min-height: 46px;
  padding: 10px 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink);
  font: inherit;
  background: var(--wash);
}

input[type="search"]:focus {
  outline: 3px solid rgba(23, 124, 114, 0.16);
  border-color: var(--accent);
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-end;
  min-width: 280px;
}

.stats span {
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--wash);
  color: var(--muted);
  white-space: nowrap;
}

.stats strong {
  color: var(--ink);
}

.section {
  padding: 72px clamp(18px, 4vw, 56px);
}

.band {
  background: var(--paper);
}

.section-heading {
  display: grid;
  gap: 10px;
  max-width: 980px;
  margin-bottom: 30px;
}

.roadmap-grid,
.course-grid,
.resource-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.card,
.stage-card,
.course-card,
.resource-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--paper);
  box-shadow: 0 10px 28px rgba(23, 37, 42, 0.05);
}

.stage-card,
.course-card,
.resource-card {
  display: flex;
  min-height: 100%;
  flex-direction: column;
  padding: 18px;
}

.stage-head,
.course-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 3px 9px;
  border-radius: 8px;
  color: var(--accent-strong);
  font-size: 12px;
  font-weight: 800;
  background: rgba(23, 124, 114, 0.1);
  white-space: nowrap;
}

.stage-card p,
.course-card p,
.resource-card p {
  color: var(--muted);
}

.checklist {
  display: grid;
  gap: 8px;
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
}

.checklist label {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  gap: 9px;
  align-items: start;
  color: #303b44;
  font-size: 14px;
}

.checklist input {
  width: 16px;
  height: 16px;
  margin-top: 4px;
  accent-color: var(--accent);
}

.output {
  margin-top: auto;
  padding-top: 14px;
  color: var(--accent-strong);
  font-weight: 700;
}

.course-card.featured {
  border-color: rgba(196, 124, 31, 0.5);
  background: #fffaf1;
}

.course-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding-top: 16px;
}

.pill-link {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 7px 10px;
  color: var(--accent-strong);
  font-size: 13px;
  font-weight: 800;
}

.project-list {
  display: grid;
  gap: 10px;
}

.project-row {
  display: grid;
  grid-template-columns: 82px minmax(220px, 0.6fr) minmax(0, 1fr);
  gap: 14px;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--paper);
}

.level {
  color: var(--accent-strong);
  font-weight: 900;
}

.project-title {
  font-weight: 800;
}

.project-learn {
  color: var(--muted);
}

.reader-layout {
  display: grid;
  grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

.reader-menu {
  position: sticky;
  top: 88px;
  max-height: calc(100vh - 110px);
  overflow-y: auto;
  padding-right: 6px;
}

.reader-menu::-webkit-scrollbar {
  width: 6px;
}

.reader-menu::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 6px;
}

.reader-group {
  margin-bottom: 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  background: var(--paper);
}

.reader-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 8px 11px;
  color: var(--ink);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.3px;
  background: var(--subtle);
  border: none;
  cursor: pointer;
  text-align: left;
}

.reader-group-title::after {
  content: "▾";
  font-size: 12px;
  color: var(--muted);
  transition: transform 0.2s ease;
}

.reader-group.collapsed .reader-group-title::after {
  transform: rotate(-90deg);
}

.reader-group-items {
  display: grid;
  gap: 2px;
  padding: 6px;
}

.reader-group.collapsed .reader-group-items {
  display: none;
}

.reader-link {
  width: 100%;
  min-height: 36px;
  padding: 7px 10px;
  color: var(--ink);
  font: inherit;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 6px;
}

.reader-link:hover {
  background: rgba(23, 124, 114, 0.06);
}

.reader-link.active {
  color: #fff;
  border-color: var(--accent);
  background: var(--accent);
}

.reader-link.done::before {
  content: "✓";
  color: var(--done);
  font-weight: 800;
  font-size: 12px;
}

.reader-link.active.done::before {
  color: #a8e6cf;
}

.reader-main {
  display: grid;
  gap: 12px;
}

.reader-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.reader-toolbar .button {
  min-height: 36px;
  padding: 7px 12px;
  font-size: 13px;
}

.doc-view {
  min-height: 540px;
  padding: clamp(18px, 3vw, 32px);
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--paper);
  box-shadow: var(--shadow);
}

.doc-view h1,
.doc-view h2,
.doc-view h3 {
  margin: 1.2em 0 0.45em;
}

.doc-view h1:first-child,
.doc-view h2:first-child {
  margin-top: 0;
}

.doc-view h1 {
  font-size: clamp(30px, 4vw, 48px);
}

.doc-view h2 {
  font-size: clamp(24px, 3vw, 34px);
}

.doc-view h3 {
  font-size: 22px;
}

.doc-view a {
  color: var(--accent-strong);
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.doc-view pre,
.doc-view code {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

.doc-view pre {
  overflow: auto;
  padding: 14px;
  border-radius: 8px;
  background: #11181d;
  color: #eef5f2;
}

.doc-view code {
  padding: 2px 5px;
  border-radius: 5px;
  background: var(--subtle);
}

.doc-view pre code {
  padding: 0;
  background: transparent;
}

.doc-view blockquote {
  margin: 16px 0;
  padding: 10px 14px;
  border-left: 4px solid var(--accent);
  background: var(--wash);
}

.doc-view table {
  width: 100%;
  border-collapse: collapse;
  margin: 18px 0;
  font-size: 14px;
}

.doc-view th,
.doc-view td {
  padding: 9px 10px;
  border: 1px solid var(--line);
  vertical-align: top;
}

.doc-view img {
  max-width: 100%;
  border-radius: 8px;
}

.footer {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: space-between;
  padding: 24px clamp(18px, 4vw, 56px);
  border-top: 1px solid var(--line);
  color: var(--muted);
  background: var(--paper);
}

.footer a {
  color: var(--accent-strong);
  font-weight: 800;
}

.hidden {
  display: none !important;
}

@media (max-width: 980px) {
  .hero,
  .toolbar,
  .reader-layout {
    grid-template-columns: 1fr;
  }

  .roadmap-grid,
  .course-grid,
  .resource-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats {
    justify-content: flex-start;
    min-width: 0;
  }

  .reader-menu {
    position: static;
  }
}

@media (max-width: 680px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .topnav {
    justify-content: flex-start;
  }

  .hero {
    min-height: auto;
    padding-top: 42px;
  }

  .roadmap-grid,
  .course-grid,
  .resource-grid {
    grid-template-columns: 1fr;
  }

  .project-row {
    grid-template-columns: 1fr;
    gap: 4px;
  }
}
