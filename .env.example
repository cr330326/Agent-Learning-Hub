# Generate a long random value and keep it outside Git.
BETTER_AUTH_SECRET=
# Public origin used by Better Auth to validate redirects and cookies.
BETTER_AUTH_URL=https://example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register ${BETTER_AUTH_URL}/api/auth/callback/github in the GitHub OAuth app.
ADMIN_GITHUB_IDS=
# Optional encrypted-backup mount visible to the application health summary.
BACKUP_OUTPUT_DIR=
# Production runbooks mount this host directory read-only at /data/backups.
BACKUP_HOST_PATH=/var/backups/agent-learning-hub
# Stable production state volume; change only during a controlled restore.
STATE_VOLUME_NAME=agent-learning-hub-production-state
DISCOVERY_VOLUME_NAME=agent-learning-hub-production-discovery
DISCOVERY_TEMP_VOLUME_NAME=agent-learning-hub-production-discovery-temp
# Host-side maintenance commands may use this to persist anonymous command metrics.
OPERATIONAL_METRICS_DATABASE_PATH=
# Release Compose only: pin a published version or digest; never use latest.
APP_IMAGE=ghcr.io/cr330326/agent-learning-hub:v0.1.0
APP_BIND_HOST=127.0.0.1
# Cloud-host loopback port for release mode (Caddy proxies to it). Local
# dev-machine defaults are higher to avoid the common 3000 conflict:
# local preview 3001, cloud preview 3002 — see code/scripts/docker-deploy.sh.
APP_PORT=3000

# Cloud discovery worker. Prices are CNY/USD per million tokens.
# Set both prices explicitly. USD pricing also requires a CNY exchange rate.
DISCOVERY_MODEL_URL=
DISCOVERY_MODEL_KEY=
DISCOVERY_MODEL_NAME=
# Output-limit parameter supported by the provider. DeepSeek uses max_tokens.
# Set max_completion_tokens only for providers that require that spelling.
DISCOVERY_MODEL_TOKEN_LIMIT_FIELD=max_tokens
DISCOVERY_INPUT_PRICE=
DISCOVERY_OUTPUT_PRICE=
DISCOVERY_PRICE_CURRENCY=CNY
DISCOVERY_EXCHANGE_RATE=
# Use a renewable tenant identity or an operator-managed access token.
FEISHU_ACCESS_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Existing authorized credential for reading the private openspace result files.
OPENSPACE_GITHUB_TOKEN=
# Initialize the confirmed Feishu and openspace aggregation sources on first use.
DISCOVERY_AGGREGATION_PRESETS=0
# Repository-scoped GitHub App used for curriculum pull requests.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY=cr330326/agent-learning-hub
GITHUB_BASE_BRANCH=main
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Host file mounted read-only by docker-compose.github-app.yml when enabled.
GITHUB_APP_PRIVATE_KEY_FILE=
