# Generate a long random value and keep it outside Git.
BETTER_AUTH_SECRET=
# Public origin used by Better Auth to validate redirects and cookies.
BETTER_AUTH_URL=https://example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register ${BETTER_AUTH_URL}/api/auth/callback/github in the GitHub OAuth app.
ADMIN_GITHUB_IDS=
# Optional encrypted-backup mount visible to the application health summary.
BACKUP_OUTPUT_DIR=
# Production runbooks mount this host directory read-only at /data/backups.
BACKUP_HOST_PATH=/var/backups/agent-learning-hub
# Stable production state volume; change only during a controlled restore.
STATE_VOLUME_NAME=agent-learning-hub-production-state
# Host-side maintenance commands may use this to persist anonymous command metrics.
OPERATIONAL_METRICS_DATABASE_PATH=
# Release Compose only: pin a published version or digest; never use latest.
APP_IMAGE=ghcr.io/cr330326/agent-learning-hub:v0.1.0
APP_BIND_HOST=127.0.0.1
# Cloud-host loopback port for release mode (Caddy proxies to it). Local
# dev-machine defaults are higher to avoid the common 3000 conflict:
# local preview 3001, cloud preview 3002 — see code/scripts/docker-deploy.sh.
APP_PORT=3000
